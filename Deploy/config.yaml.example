profile: personal
listen_address: 127.0.0.1:8787
# 源码开发可留空并使用当前用户配置目录/Oktapod。
# 正式部署使用绝对路径：Windows 可用 C:/ProgramData/Oktapod/data，Linux 可用 /var/lib/oktapod。
data_root: ""
run_concurrency: 4
database:
  driver: sqlite
model:
  # 从请求发出到首个正文、推理或工具调用 Token；空 SSE/keep-alive 不计入。
  first_token_timeout: 15s
  # 首 Token 后连续没有任何 SSE 行的最长时间。
  stream_idle_timeout: 60s
  # 整轮硬上限；显式高级思考可更长，但始终有界。
  turn_timeouts:
    auto: 120s
    off: 120s
    low: 180s
    medium: 300s
    high: 600s
capabilities:
  # 相对路径按 config.yaml 所在目录解析；正式部署也可填写绝对路径。
  trusted_keys_file: trusted-keys.json
web_access:
  private_fetch:
    # 默认关闭。开启后至少配置一个精确的字面量 IP + 端口 origin，并重启服务。
    enabled: false
    allowed_origins: []
    # 示例：
    # - id: intranet-wiki
    #   origin: http://192.168.10.20:8080
    # - id: local-preview
    #   origin: http://127.0.0.1:3000
    # - id: ipv6-service
    #   origin: https://[fd00::20]:8443
