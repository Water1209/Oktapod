# Oktapod 部署环境变量样例
# 监听地址（personal 仅允许 loopback）
OKTAPOD_LISTEN_ADDRESS=127.0.0.1:8787
# 数据根目录（默认 os.UserConfigDir()/Oktapod）
# OKTAPOD_DATA_ROOT=/var/lib/oktapod
# Profile: personal | team
OKTAPOD_PROFILE=personal
# Team 模式 PostgreSQL DSN
# OKTAPOD_DATABASE_URL=postgres://oktapod:URL_ENCODED_PASSWORD@localhost:5432/oktapod?sslmode=disable
# OKTAPOD_DATABASE_BACKUP_URL=postgres://oktapod:URL_ENCODED_PASSWORD@localhost:5432/oktapod_backup?sslmode=disable
# V1 不提供 Team/Compose 发布路径。未来兼容 PostgreSQL 时，凭据必须由部署环境注入，
# 不能放入仓库、示例文件或本地持久配置。
# 能力包可信公钥（JSON: {"key-id": "base64-ed25519-public-key"}）
# OKTAPOD_CAPABILITY_TRUSTED_KEYS_JSON={}
