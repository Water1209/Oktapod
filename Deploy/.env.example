# Oktapod 仅保留启动前无法从产品数据库读取的 Bootstrap 环境变量。
# 常规 Personal 配置请复制 config.yaml.example，并通过设置页统一维护。
# OKTAPOD_CONFIG_FILE=/etc/oktapod/config.yaml

# Team/PostgreSQL 后续兼容边界：数据库尚未打开时只能由部署系统注入连接凭据。
# OKTAPOD_DATABASE_URL=postgres://oktapod:URL_ENCODED_PASSWORD@localhost:5432/oktapod?sslmode=verify-full
# OKTAPOD_DATABASE_BACKUP_URL=postgres://oktapod:URL_ENCODED_PASSWORD@localhost:5432/oktapod_backup?sslmode=verify-full

# Team 运维 Bootstrap Token；Personal V1 不需要。
# OKTAPOD_TEAM_ADMIN_TOKEN=inject-from-deployment-secret-manager
