{
  "name": "oktapod",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --dir Src/web dev",
    "build:web": "pnpm --dir Src/web build",
    "build": "pnpm build:web && go build -o Build/ ./Src/cmd/oktapod",
    "lint": "pnpm --dir Src/web lint",
    "test:web": "pnpm --dir Src/web test",
    "test": "go test ./... && pnpm test:web",
    "verify": "go vet ./... && pnpm lint && pnpm test && pnpm build",
    "test:e2e": "pnpm --dir Src/web test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
