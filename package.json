{
  "name": "oktapod",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --dir Src/web dev",
    "build:web": "pnpm --dir Src/web build",
    "build": "pnpm build:web && go build -o Build/ ./Src/cmd/oktapod",
    "release:build": "node Test/build-release.mjs",
    "release:document-runtime": "node Test/build-document-runtime.mjs",
    "release:smoke": "node Test/release-smoke.mjs",
    "lint": "pnpm --dir Src/web lint",
    "test:web": "pnpm --dir Src/web test",
    "test:race": "go test -race -timeout 20m ./...",
    "test:migrations": "go test ./Src/internal/adapters/db/sqlite -run Migration -count=1",
    "test:document-runtime": "node Test/document-runtime-smoke.mjs",
    "verify:openapi": "node Test/openapi-drift.mjs",
    "test": "go test ./... && pnpm test:web",
    "verify": "go vet ./... && pnpm lint && pnpm test && pnpm build && pnpm test:migrations && pnpm verify:openapi",
    "verify:ci": "pnpm verify && pnpm test:race",
    "test:e2e": "pnpm --dir Src/web test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
